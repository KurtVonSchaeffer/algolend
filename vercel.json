{
  "version": 2,
  "rewrites": [
    { "source": "/admin-panel/:path*", "destination": "/admin/index.html" },
    { "source": "/portal/:path*",      "destination": "/portal/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/admin/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/flag-defaults",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/section129",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/monthly-statements",
      "schedule": "0 7 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://zw-express.vercel.app;"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
